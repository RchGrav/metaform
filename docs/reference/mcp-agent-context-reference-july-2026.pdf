      ],
      "callback": "({ department, name }) => ({\n      messages: [\n        {\n          role: \"user\",\n          content: {\n            type: \"text\",\n            text: `Please promote ${name} to the head of the ${department} team.`,\n          },\n        },\n      ],\n    })",
