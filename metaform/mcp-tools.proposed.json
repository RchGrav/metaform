{
  "tools": [
    {
      "name": "project-map",
      "description": "Use this single Metaform tool for add, update, delete, orphaned, goto, map, help, raw dumps and addressed reads. Work on one receiving element at a time. Input addresses select actual elements in the nested namespace. A want names the wanted element by its address.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "A command name (add, update, delete, orphaned, goto, map, help) is a command. A key that starts with a period is a raw dump. Any other key is an address, and reads that element. The selected project comes from caller context. Addresses in commands are selectors; storage remains a nested namespace.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "add": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "pattern": "^(?:\\.|[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*)$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/AddFields"
                }
              }
            },
            "required": [
              "add"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "update": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "pattern": "^(?:\\.|[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*)$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/UpdateFields"
                }
              }
            },
            "required": [
              "update"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "delete": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "pattern": "^[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Empty"
                    },
                    {
                      "$ref": "#/$defs/DeleteWants"
                    }
                  ]
                }
              }
            },
            "required": [
              "delete"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "orphaned": {
                "$ref": "#/$defs/Empty"
              }
            },
            "required": [
              "orphaned"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "help": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Empty"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            },
            "required": [
              "help"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "goto places the agent at an address and returns its summary sheet: the element and its wants, what relies on it, layer record counts, skill frontmatter and the memory count. A later goto to the same address in the same context returns only what changed.",
            "properties": {
              "goto": {
                "type": "string",
                "pattern": "^(?:\\.|[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*)$"
              }
            },
            "required": [
              "goto"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "map returns the shallow graph: every element address, each want as an edge from the element that holds it to the element it names, and each Defining Element. No fields and no layers.",
            "properties": {
              "map": {
                "$ref": "#/$defs/Empty"
              }
            },
            "required": [
              "map"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "A key that starts with a period is a raw dump: the stored nested JSON at that path, which is the JSON path $.<project><path> with $.<project> left off. \".\" dumps the whole project; \".code.server\" dumps that element and everything beneath it. Every layer is included.",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {
              "pattern": "^\\.(?:[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*)?$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/Empty"
            }
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {
              "pattern": "^(?!(?:add|update|delete|orphaned|goto|map|help)$)[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/LayerRead"
            },
            "description": "An addressed read: the element's own fields, plus each layer named with {} as its value."
          }
        ],
        "$defs": {
          "NamespaceValue": {
            "title": "Value at a namespace address",
            "description": "Objects extend the addressed hierarchy or hold structured data. Arrays denote composed element layers; scalars are direct values.",
            "oneOf": [
              {
                "$ref": "#/$defs/NamespaceNode"
              },
              {
                "$ref": "#/$defs/ComposedElementLayer"
              },
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            ]
          },
          "NamespaceNode": {
            "title": "Namespace branch or receiving element",
            "description": "Namespace branch or receiving element. Its properties and layers are directly on the element. The same word can name metadata or a namespace branch according to its value and context.",
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The name used for this functionality in project documentation or specifications, such as Metaform.",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "$ref": "#/$defs/NamespaceNode"
                  },
                  {
                    "$ref": "#/$defs/ComposedElementLayer"
                  }
                ]
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The element's role in the intake: AT (Artifact Type, the type that groups the artifacts examined), DE (Defining Element, whose loss would prevent the artifact from remaining the same type), SE (Supportive Element, whose Encounter Function helps a Defining Element serve the purpose of the CQU), NE (Notable Element, which states an essential demand or requirement), CQU (Cestui Que Use, the party outside the artifact whose purpose drives improvement of it), UD (Upstream Dependency, an element outside the artifact that an element depends on) or DD (Downstream Dependant, an element outside the artifact that depends on it and is not a person). A map may hold several Defining Elements."
                  },
                  {
                    "$ref": "#/$defs/NamespaceNode"
                  },
                  {
                    "$ref": "#/$defs/ComposedElementLayer"
                  }
                ]
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Implementation state. Use un_built for intended functionality not yet built. Legacy missing/todo spellings and intake BKN/broken judgments are not accepted. Other lifecycle state names are not defined by this schema.",
                    "minLength": 1,
                    "pattern": "\\S",
                    "not": {
                      "enum": [
                        "missing",
                        "MISSING",
                        "BKN",
                        "broken",
                        "todo",
                        "TODO"
                      ]
                    }
                  },
                  {
                    "$ref": "#/$defs/NamespaceNode"
                  },
                  {
                    "$ref": "#/$defs/ComposedElementLayer"
                  }
                ]
              },
              "technical_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The well-understood practitioner short name derived from the leaf segments. Must exactly match the same number of leading words of the reversed, space-separated namespace address, and must not match `name`.",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "$ref": "#/$defs/NamespaceNode"
                  },
                  {
                    "$ref": "#/$defs/ComposedElementLayer"
                  }
                ]
              },
              "wants": {
                "$ref": "#/$defs/Wants"
              },
              "why": {
                "$ref": "#/$defs/RelationshipWord"
              },
              "how": {
                "$ref": "#/$defs/RelationshipWord"
              },
              "project": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Optional project metadata; does not introduce a required wrapper."
                  },
                  {
                    "$ref": "#/$defs/NamespaceNode"
                  },
                  {
                    "$ref": "#/$defs/ComposedElementLayer"
                  }
                ]
              },
              "refs": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "description": "The source links for this element: one uri for each artifact that has this address. A code project is one artifact, so it has one uri, the entry point for this functionality. When several artifacts share the address, such as photos of one type, list the uri of each. A relative file path is allowed."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uri": {
                "not": {},
                "description": "Not a field. Use refs."
              },
              "providers": {
                "$ref": "#/$defs/NamespaceNode",
                "description": "This word may name a namespace branch. The functional relationships are in wants, not providers."
              },
              "direction": {
                "$ref": "#/$defs/RelationshipWord"
              }
            },
            "additionalProperties": {
              "$ref": "#/$defs/NamespaceValue"
            },
            "propertyNames": {
              "pattern": "^[^.$\\[\\]\\s]+$",
              "description": "One namespace segment, never a dotted reference or JSONPath expression."
            }
          },
          "ComposedElementLayer": {
            "title": "Array-valued composed element layer",
            "description": "An array at an element is a knowledge layer. Its members retain their native formats and nesting. Do not reinterpret fields inside native members as functional namespace branches.",
            "type": "array",
            "items": true
          },
          "Wants": {
            "title": "Wants",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/WantRecord"
            },
            "description": "What this receiving element wants: a list of want records. The intake procedure calls these dependency records."
          },
          "WantRecord": {
            "title": "Want record",
            "description": "One want of this receiving element: the element it wants, why it wants it, how that element serves the purpose, and the direction of the flow. These are one set. It may name the one artifact it is about in ref. An element may hold several wants on the same element.",
            "type": "object",
            "properties": {
              "element": {
                "type": "string",
                "pattern": "^[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*$",
                "description": "The address of the element that this receiving element wants. The intake procedure calls it the Providing Element (PE). It refers to the actual element in the nested tree, which keeps its own fields at its own location."
              },
              "why": {
                "type": "string",
                "description": "What this receiving element seeks to accomplish through the wanted element. The intake procedure calls it the Operative Purpose (OP). Use clear, simple technical English.",
                "minLength": 1,
                "pattern": "\\S"
              },
              "how": {
                "type": "string",
                "description": "How the wanted element serves that purpose in this encounter. The intake procedure calls it the Encounter Function (EF). Use clear, simple technical English.",
                "minLength": 1,
                "pattern": "\\S"
              },
              "direction": {
                "type": "string",
                "description": "The direction of the movement of substance that satisfies the purpose, relative to the receiving element and not including the request: send, receive or both. The intake procedure calls it the Information Flow Direction (IFD).",
                "enum": [
                  "send",
                  "receive",
                  "both"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "The uri of the one artifact this want is about. When a map covers several artifacts, such as a folder of photographs, each want names its artifact here, and an element holds one want for each artifact."
              }
            },
            "required": [
              "element",
              "why",
              "how",
              "direction"
            ],
            "additionalProperties": false
          },
          "Empty": {
            "type": "object",
            "maxProperties": 0
          },
          "LayerRead": {
            "type": "object",
            "description": "Name each layer to read at the address where it is written, with {} as its value, such as {\"wants\": {}} or {\"specification\": {}}. An empty object reads only the element's own fields.",
            "propertyNames": {
              "pattern": "^[^.$\\[\\]\\s]+$",
              "description": "One layer name: one namespace segment."
            },
            "additionalProperties": {
              "$ref": "#/$defs/Empty"
            }
          },
          "AddFields": {
            "allOf": [
              {
                "$ref": "#/$defs/NamespaceNode"
              }
            ],
            "type": "object",
            "minProperties": 1,
            "properties": {
              "wants": {
                "$ref": "#/$defs/Wants"
              }
            },
            "description": "Fields supplied for one receiving element. Command addresses select actual nested elements."
          },
          "WantUpdate": {
            "type": "object",
            "minProperties": 2,
            "required": [
              "element"
            ],
            "properties": {
              "element": {
                "$ref": "#/$defs/WantRecord/properties/element"
              },
              "why": {
                "$ref": "#/$defs/WantRecord/properties/why"
              },
              "how": {
                "$ref": "#/$defs/WantRecord/properties/how"
              },
              "direction": {
                "$ref": "#/$defs/WantRecord/properties/direction"
              },
              "ref": {
                "$ref": "#/$defs/WantRecord/properties/ref"
              }
            },
            "additionalProperties": false,
            "description": "The record names the element of one want, and its ref or its why when the element has several wants. The other fields supplied change that want."
          },
          "WantsUpdate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/WantUpdate"
            },
            "description": "Like Wants; each record holds element and only the fields to change."
          },
          "UpdateFields": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[^.$\\[\\]\\s]+$",
              "description": "One namespace segment, never a dotted reference or JSONPath expression."
            },
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/name"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "role": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/role"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/status"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "technical_name": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/technical_name"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wants": {
                "$ref": "#/$defs/WantsUpdate"
              },
              "why": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/why"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "how": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/how"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "project": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/project"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "refs": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/refs"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uri": {
                "not": {},
                "description": "Not a field. Use refs."
              },
              "providers": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/providers"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "direction": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NamespaceNode/properties/direction"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": {
              "$ref": "#/$defs/NamespaceValue"
            },
            "description": "Update supplied fields on one receiving element. Null removes a property; omission leaves it unchanged. Delete individual wants with delete."
          },
          "DeleteWants": {
            "type": "object",
            "properties": {
              "wants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[^.$\\[\\]\\s]+(?:\\.[^.$\\[\\]\\s]+)*$"
                }
              }
            },
            "required": [
              "wants"
            ],
            "additionalProperties": false
          },
          "RelationshipWord": {
            "anyOf": [
              {
                "$ref": "#/$defs/NamespaceNode"
              },
              {
                "$ref": "#/$defs/ComposedElementLayer"
              }
            ],
            "description": "This word may name a namespace branch or native layer. The fields element, why, how and direction belong inside a want record, not on the element."
          }
        }
      }
    }
  ]
}
