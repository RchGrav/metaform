<?xml version="1.0" encoding="utf-8"?>
<!-- The hello module's prompts: the text Metaform sends to agents for the hello module.
     Each element is one prompt, named by its tag. What is between the tags is sent exactly as written.
     An empty element inside a prompt, such as <name/>, would mark a place the code fills in; this file has none.
     Comments are never sent. -->
<prompts>
<!-- hello's line in the connect message: what an agent uses hello for, one short phrase after its name, in the
     project's terms. Sent to every agent when it connects over MCP, one line per enabled module under mcp's
     <instructions>, and listed in the compact command-line guide, metaform help agents. Empty sends nothing for
     hello. Off when the module is disabled or the folder's modules setting leaves it out. -->
<connect>– hello: see each module feature working once</connect>
<!-- hello's instructions. Returned by metaform_instructions with module hello, at metaform://instructions/hello, and printed by
     metaform help agents hello and by the full form of the command-line guide. Empty sends nothing. The module
     ships disabled: nothing here is sent until it is enabled. -->
<instructions>hello is active.</instructions>
<!-- An authored responsibility resolved through the public agent.roles provider while hello is enabled. -->
<role_greeter>Welcome the assigned visitor using the hello greeting operations and return the result to the recorded caller.</role_greeter>
</prompts>
