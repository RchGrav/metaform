[project]
name = "metaform-user-modules"
version = "0.0.0"
requires-python = ">=3.11"
dependencies = ["metaform==@VERSION@", "agent-client-protocol>=0.12.1,<0.13", "mcp>=2.2,<3"]

[dependency-groups]
dev = ["pytest>=8", "pyright==1.1.414", "ruff==0.16.9"]

[tool.uv]
package = false

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.11"
exclude = ["**/tests", ".venv", ".metaform"]

[tool.ruff]
line-length = 120
target-version = "py311"

[tool.metaform.fork]
repository = true
