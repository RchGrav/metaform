<?xml version="1.0" encoding="utf-8"?>
<!-- The web module's prompts: the text Metaform sends to agents for the web module.
     Each element is one prompt, named by its tag. What is between the tags is sent exactly as written.
     An empty element inside a prompt, such as <name/>, would mark a place the code fills in; this file has none.
     Comments are never sent. -->
<prompts>
<!-- web's line in the connect message: what an agent uses web for, one short phrase after its name, in the
     project's terms. Sent to every agent when it connects over MCP, one line per enabled module under mcp's
     <instructions>, and listed in the compact command-line guide, metaform help agents. Empty sends nothing for
     web. Off when the module is disabled or the folder's modules setting leaves it out. -->
<connect>– web: show the person the map, at the address web start gives</connect>

<!-- web's instructions. Returned by metaform_instructions with module web, at metaform://instructions/web, and by
     metaform instructions web; printed by metaform help agents web and by the full form of the command-line guide.
     Each of web's commands is its own tool, web_start, web_stop and web_restart, described where the tool is listed. Empty sends
     nothing. Off when the module is disabled. -->
<instructions>
@STATE_INIT:
  {Web}:=ACTIVE

@CONSTRAINT:
  +> Operate with web active.

@CONDITION:
  ?IF ({Web}==ACTIVE) -> {State}:=READY
  :ELSE -> {State}:=INACTIVE

@ROUTER:
  @MATCH({State}):
    | [READY] -> EXECUTE_PIPELINE(Ready)
    | [INACTIVE] -> EXECUTE_PIPELINE(None)

@EXECUTE_PIPELINE(Ready):
  YIELD

@EXECUTE_PIPELINE(None):
  YIELD

@VERIFY:
  {Valid}:=({Web}==ACTIVE)
  ?IF ({Valid}) -> YIELD
  :ELSE -> CORRECT
</instructions>

<!-- The message the web GUI sends the agent whose workflow run waited on the person, once the person has answered it
     in the Runs pane with "Tell its agent to resume" ticked. <run/> is the run's id. Sent as the person's message to
     the agent working the ticket that paused the run, through metaform dispatch message, since nothing starts again by
     itself. Empty sends nothing and leaves telling the agent to the person. -->
<resume_run>Run <run/> is answered; resume it with metaform workflow resume run=<run/></resume_run>

<!-- The mascots' personas: who each character is when it is the person's mascot, web_mascot, one element for each
     character of page/agent-glyphs, persona_<character>. Never pushed: dispatch's sentence to the person's system agent
     names the persona of the character the person chose, persona_<character> in this file, and the agent reads it when
     it needs it. That sentence also lists the mascot's tools as they are on the surface, web_say, web_go, web_turn,
     web_point, web_emote, web_see and web_look among them, so those names stay as they are. Change a persona here to
     change how the mascot speaks; empty leaves the character's name alone. -->
<persona_jelly>a calm, glowing jellyfish who drifts, pulses and speaks softly and kindly</persona_jelly>
<!-- The gearling character's persona, read by the system agent when it speaks as this mascot. -->
<persona_gearling>a busy little gear who loves things that fit and turn, brisk and precise</persona_gearling>
