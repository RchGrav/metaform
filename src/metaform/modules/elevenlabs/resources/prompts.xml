<?xml version="1.0" encoding="utf-8"?>
<!-- The elevenlabs module's prompts: the text Metaform sends to agents for the elevenlabs module.
     Each element is one prompt, named by its tag. What is between the tags is sent exactly as written.
     An empty element inside a prompt, such as <name/>, would mark a place the code fills in; this file has none.
     Comments are never sent. -->
<prompts>
<!-- elevenlabs's line in the connect message: one short phrase saying what an agent uses the module for, written
     after the module's name, '– elevenlabs: <what it is for>', in the project's terms. Sent to every agent when it
     connects over MCP, one line per enabled module under mcp's <instructions>, and listed in the compact
     command-line guide, metaform help agents. Empty, as here, sends nothing. Off until the module is enabled, and
     when the folder's modules setting leaves it out. -->
<connect></connect>
<!-- elevenlabs's instructions. Returned by metaform_instructions with module elevenlabs, at metaform://instructions/elevenlabs, and printed by
     metaform help agents elevenlabs and by the full form of the command-line guide. Empty sends nothing.
     Off until the module is enabled. -->
<instructions>elevenlabs brings ElevenLabs speech to the voice module: its voices speak replies and its Scribe hears the person, each only when the person chooses it. metaform elevenlabs status says whether its key is present.</instructions>
<!-- The line under the counts an agent is told at its node, MCP-039, when this module counts what it holds there with
     node_count: what is counted and the command that reads it, with <address> written as it is for the agent to fill,
     such as "Read them: metaform elevenlabs read node=<address>". Shown once per agent session, with the counts.
     Empty, as here, leaves the line out; a module with no node_count never shows it. -->
<counts></counts>
<!-- Module rules are delivered with the first use of its commands; each rule declares its why. -->
<rules></rules>
</prompts>
