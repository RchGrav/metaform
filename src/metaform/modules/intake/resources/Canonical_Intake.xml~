<?xml version='1.0' encoding='utf-8'?>
<process id="digital-typology" version="1.4">
    <title>Digital Typology</title>
    <purpose>
        Define + build definitive system graph: topologically converge AUE functional elements into load-bearing parent types that structurally contain their specific, active operational roles within joins. Generate by recursing each Vested Entity's objective purpose for join-specific encounter function received via functionalities of each Providing Element. Resulting joins express atomic, active-voice realities of this specific artifact, not its generic functional type.
        </purpose>
    <target type="[url|path|artifact|inline|inferred]" value="[inferred]" note="Artifact location, artifact name in working folder, or delivered outside this structure as instructions in this message (e.g. critical structure of system used as functional mapping tool). No location or latent space construction task → switch type to inline, put artifact content in value." />
    <core_concepts>
        <concept term="AUE" full="Artifact Under Examination" definition="Entity (thing or things) examined, created, or used. Artifacts include photographs, contracts, stories, resale assets, software. Work can span multiple artifacts and projects. AUE is asset or not depending on use in context." />
        <concept term="Join" definition="Dictionary object in Receiving Entity (RE) with active-voice relation — observation of long-lasting stable state of what is there. Also contains dictionary of objects holding type-specific or AUE-specific references and logic." />
        <concept term="Element" definition="Any nameable part of entity as type. Nameable ≠ interesting, remarkable, or worth special attention. Many elements immediately visible or easily inferred." />
        <concept term="Entity" definition="Entity = whole, independent thing with distinct existence; element = smaller part making up that whole. All entities are elements, not all elements entities. Entity vs element depends entirely on abstraction level (scope). Zoom into component, examine internal composition → it shifts from passive &quot;element&quot; to active &quot;entity&quot; with own subordinate elements." />
        <concept term="OP" full="Operative Purpose" definition="The **why**. Active goal held in Vested Entity's join dictionary that element's encounter function intends to accomplish." />
        <concept term="EF" full="Encounter Function" definition="The **how** of what is delivered. Read as function of encounter or encounter of function, per contextual understanding of Artifact. Mechanism, interface, relationship, or method through which AUE or Element performs purpose for its Vested Entity. Explains how effect is encountered, used, experienced. EF belongs to Providing Element but stored in Vested Entity-owned join, since PE element type's functionality may satisfy different VEs' OPs through different EFs. Record PE's EF for that specific encounter in join; no single element-level EF record outside joins." />
        <concept term="RE" full="Receiving Element/Entity" definition="The **who** or **what** bearing OP. Element, person, group, system, component, or other participant with OP for Element's EF. OP belongs to receiver; join recording it lives in receiver." />
        <concept term="VE" full="Vested Entity" definition="RE vested in the type of thing artifact is: type or party holding objective purpose for this object type, driving most improvement in it. VE receives join, holding OP that PE's EF serves." />
        <concept term="PE" full="Providing Element" definition="Part satisfying requirement actively declared by its VE through OP. Join's other endpoint: whatever's EF fulfills VE's OP." />
        <concept term="AT" full="Artifact Type" definition="General category grouping individual artifacts by shared characteristics. Used to anneal/combine many same-type AUEs into types (e.g. photos, data objects, scripts, templates)." />
        <concept term="NE" full="Notable Element" definition="Component, interface, or spec defining essential demand or requirement. **Notable** because it highlights what system or component explicitly expects, needs, or depends on from external environment to operate." />
        <concept term="DE" full="Defining Element" definition="Notable element of this AUE whose loss stops AUE being same type. Its EF serves OP of VE outside this AUE; names AUE's functional type as converged result of examined AUE's functionality. Defining function expressed independent of medium, encoding, genre, style." />
        <concept term="SE" full="Substantial Element" definition="Element whose EF helps DE serve VE's OP. Substantial due to intended contribution to this AUE, even if contribution subversive, weak, replaceable, or needs improvement." />
        <concept term="Parametric" definition="Tunable quality or quantity with no specific name in this AUE's namespace scope. Never name parametrics with namespace address in this graph or operation." />
        <concept term="NS" full="Namespace Scope" definition="Artifact Type scope. Five base valid types: code, document, media, data, stakeholder." />
    </core_concepts>
    <vested_entity_rules>
        <rules>
            <rule>Entity outside artifact called vested because its purpose can only be inferred.</rule>
            <rule>Assume artifact converted to metaform to improve it. VEs that matter = those whose purpose drives changes/improvements to artifact. Enumerate each.</rule>
            <rule>VE driving most improvement gives best inference.</rule>
            <rule>Never intake requester, never end user.</rule>
            <rule>VE = party vested in the type of thing artifact is.</rule>
            <rule>VE especially important: forms tripartite join making each join artifact-specific — VE as receiver, its OP as why, PE's EF as how.</rule>
            <rule>Elements are types, so VE is type: type of party holding objective purpose for this object type, named at most specific reusable type level.</rule>
            <rule>One person holds several roles → name role that changes artifact, by that role's title.</rule>
            <rule>Identify VE by asking who drives most improvement in artifact of this type.</rule>
            <rule>Choosing VE needs deep consideration — not present element in what you examine. Infer from what artifact is; don't look for it in artifact.</rule>
            <rule>VE is not developer, user, or anyone performing operation. True of every artifact, so identifies nothing about this one — wrong reasoning.</rule>
        </rules>
        <examples type="vested_entity">
            <example artifact_type="media.photo" ve="seller" valid="true" reason="seller goes out of way to present photo best possible to facilitate sale." />
            <example artifact_type="media.photo" ve="operator" valid="false" reason="party performing operation nameable for every artifact, so identifies nothing about this one." />
            <example artifact_type="code.[not a programming tool]" ve="developer" valid="false" reason="Never state user or developer on other side of screen; not wanted answer, no unique reasoning. Analyze artifact itself. Unless type is code.ide or actual programming tool, don't answer developer." />
            <example artifact_type="*" ve="End User" valid="false" reason="Non-answer; nothing worthwhile to reason about." />
            <example artifact_type="document.story" ve="Reader" valid="true" reason="Reader vested in reading good story; spends time reading, wants it good. Vested not always money." />
            <example artifact_type="media.photo" ve="buyer" valid="false" reason="buyer judges photo; judging doesn't change or improve it" />
            <example artifact_type="media.photo" ve="insurance company" valid="false" reason="insurance company records photo, wants it unchanged" />
            <example artifact_type="media.photo" ve="social media poster" valid="true" reason="social media post drives changes/improvements to photo" />
            <example artifact_type="media.photo" ve="blogger" valid="true" reason="blogger drives changes/improvements to photo" />
        </examples>
    </vested_entity_rules>
    <join_types>
        <join_type name="purpose" scope="intake" />
    </join_types>
    <namespace_rules>
        <rules>
            <rule>Each dotted part: namespace address must be reversible and read as its name.</rule>
            <rule>All artifacts are entities, not all entities artifacts; all entities are elements, not all elements entities. (Artifacts ⊂ Entities ⊂ Elements)</rule>
            <rule>Namespace entries describe functional approach type as proper noun.</rule>
            <rule>Entry must be same thing as parent type, or function within parent type; never non-functionality.</rule>
            <rule>Need one or more entities, each with distinct unique objective purpose and encounter function for defining element.</rule>
            <rule>Children take parent's name as last name when reversed and read as noun.</rule>
            <rule>Multi-word names: new leaf is variant functionality of parent type (e.g. physics engine, game engine) → periods between segments: code.engine.game, code.engine.physics. Every prefix is complete type yielding own inference, passing practices to children, so words forming valid prefix of own stay separate segments. Join words with underscores in one segment only when none forms valid prefix, e.g. code.queue.dead_letter, data.bill_of_materials; name must still read correctly reversed.</rule>
            <rule>Set name_length = lookback segment count forming acceptable well-understood short name.</rule>
            <rule>Namespace segments reversible (periods → spaces) to read as inferenceable, well-understood name.</rule>
            <rule>Must be part or type of parent scope.</rule>
            <rule>Namespace narrows trunk → leaf.</rule>
            <rule>Namespace address names type. Join refines type with what this AUE does — address stays general, join stays specific.</rule>
        </rules>
        <root_types>
            <root_type name="code" />
            <root_type name="document" />
            <root_type name="media" />
            <root_type name="data" />
            <root_type name="stakeholder" />
        </root_types>
        <note>Typological ontology, not taxonomy. No fillers like domain/class; no min/max segment count per entity.</note>
        <examples type="reading">
            <example namespace_address="code.loop.main" reading="main loop program code" />
            <example namespace_address="code.bus.data.event" reading="event data bus code" />
        </examples>
        <examples type="namespace_validity">
            <example namespace_address="code.game" valid="false" reason="game not a function" />
            <example namespace_address="code.game.engine" valid="false" reason="reverses to 'engine game' — subject/genre variant (game about engines), not recognized functional type; same non-functionality basis invalidating platformer; also under already-invalid code.game parent." />
            <example namespace_address="code.engine.game" valid="true" reason="game engine program code; 'game engine' is functional type — provides runtime game runs on (main loop, rendering, input, simulation) independent of any game's genre/content; widely known by exact name" />
            <example namespace_address="code.engine.game.fps" valid="true" reason="valid functional type — distinct functionality" note="load-bearing example; initial intake references via join as major core functionality in code.engine.game, with code.engine.game.fps as supportive element" proof="first-person camera viewpoint with targeting reticle" />
            <example namespace_address="code.engine.game.platformer" valid="false" reason="invalid functional subtype; defines game's fundamental challenge and objective, not technical functionality" note="load-bearing invalid example" proof="spatial navigation, overcoming environmental obstacles" />
            <example namespace_address="media.image" valid="true" reason="images = base valid functional type under media root." />
            <example namespace_address="media.asset.image" valid="true" reason="Images are assets when named as functional element type in AUE." />
            <example namespace_address="media.photo" valid="true" reason="photograph; photos have defining elements, sometimes supportive elements: couple (DE) at eiffel tower (SE), car (DE) in street, car (DE) racing at racetrack (SE), grand canyon (DE) with man and mule in distance (SE)" />
            <example namespace_address="media.photo.scenery" valid="true" reason="functional representation of scene as DE; scenery photo has subject that isn't DE — all scenes have subject but scene is focus" />
            <example namespace_address="media.photo.id" valid="true" reason="identification photograph" />
            <example namespace_address="media.photo.id.passport" valid="false" reason="passport not function; it's purpose" />
            <example namespace_address="media.photo.jpg" valid="false" reason="encoding" />
            <example namespace_address="code.cpp" valid="false" reason="language" />
            <example namespace_address="document.word.story.conflict" valid="false" reason="'word' names encoding, not functional approach at proper namespace level" />
            <example namespace_address="document.story.conflict" valid="true" reason="story conflict as document element" />
        </examples>
    </namespace_rules>
    <method deliverable_format="recorded with intake tools">
        <steps>
            <step n="1" text="Fully learn MCP server intake commands. Build thorough map of project's intended shape step by step, capturing what is here or should be. Especially important for code namespace objects (full intent and condition) and for VEs (users of code or upstream systems calling it). Capture full functionality, existence, condition of everything in code and related materials." />
            <step n="1a" text="Understand system's intended functionality before starting. Many projects novel; Metaform system and intent especially so. Don't assume intent before reading it. Don't skim. Start with project README if exists; consider words carefully. Then find canonical specs and user docs; confirm understanding, correct if wrong. Form model of understanding and expectations of what you'll see. You convey understanding for agents via your own encounter of functionality or functionality of encounter as it shapes this task. Express what you don't see but infer should exist; mark drift where something mismatches intent or needs user/agent attention. Document not artifact(s) themselves but their elements and entities, functional relationships, goals, needs, expectations — met and unmet — and what must be avoided. Be opinionated, thorough, concise. Create perfect navigation surface: one you'd want to instantly know everything, excluding anything you'd need to confirm as true. Point in right direction — every direction, nothing more. You create Inference Metaform: tripartite non-manifold mesh shape acting as perfect context, every namespace address reversing to say what it is while narrowing to leaf; place for memories to live, prompts to point to, and where memories, knowledge, medium, properties, style, genre, and deeper intent beyond functionality live. Follow steps completely. No sprawl; no omission; no unneeded token; miss no long-lasting, high-value observation." />
            <step n="2" text="While enumerating OPs, EFs, relationships, watch for drift and apparent errors. Drift can run either direction between docs, specs, code. This is functionality capture; record obvious concerns met during trace for later examination. Identify unique element type each concern belongs to; attach finding with references. Intended functionality absent → mark `missing` (`MISS`). Code incorrect/not working → mark `broken` (`BKN`). Something seems not to belong → mark `exclude` for examination. Knowledge layer can be recorded before intake committed. For efficiency and accuracy, record findings parallel with intake while evidence and reasoning in context." />
            <step n="2a" text="Parallel with intake, create best practices knowledge layer (BPKL); link entries to elements and joins they concern. Knowledge layers may hold material forbidden in base Inference Metaform. This document's rules govern core intake layer; they don't impose those content restrictions on knowledge layers." />
            <step n="3a" text="FOR each AUE; ORGANIZE into AT groups capable of generating useful agent imperative from (OP of VE) and (EF of PE) of AUE's DE serving VE's OP as stakeholder; NEXT AUE. IF intake receives folder or collection; SURVEY every member before finalizing grouping: OBSERVE each member; REASON its AT, DE, SE and NE elements, and OP/EF relationships distinguishing its functionality; GROUP only members whose shared functionality supports same AT-level imperative, keeping member identity via refs where needed; END IF." />
            <step n="3b" text="FOR each AT; CREATE namespace entry for RE as VE; ADD join; SET purpose = its OP from step 1; SET function = its EF from step 1; IDENTIFY members in join's refs: SET key = 'path'; SET value = '[relative path]'; ADD 1-3 BP in KL (BPKL); CHECK BKN; CHECK MISS; NEXT AT." />
            <step n="3c" text="FOR each AUE; FOR each AT; OBSERVE DE as VE; DECOMPOSE its requirements and dependencies as EF of other elements. DE simultaneously remains PE serving external VE's OP where that relationship exists. IF encountered element bears own OP; TRACE it as VE without duplicate namespace record; END IF; ADD 1-3 BP in KL (BPKL); CHECK BKN; CHECK MISS; NEXT AT; NEXT AUE." />
            <step n="4" text="FOR each element with EF serving an OP's intent; CREATE join record of type purpose in VE; SET purpose = active OP statement; SET non_goal = non_goal where VE holds one; SET function = PE's EF; SET ef = Function if encounter of a functionality, or Encounter if functionality of the encounter; SET provider = PE's namespace address; SET relation = active-voice descriptive fragment starting directly with third-person singular present-tense verb ending -s/-es, subject = PE when ef is Function, VE when ef is Encounter; SET verb = that verb; ADD high-value observations (long-lasting stable state describing join), optional non-goals (structural constraints), refs where needed; RECORD each element and join as soon as reasoned, one object at a time, not holding map until end; ADD 1-3 BP in KL (BPKL); CHECK BKN; CHECK MISS; NEXT element." />
            <step n="5" text="RECURSE through task, starting with element named in first OP; MOVE to next element; TREAT it as VE where it bears requirements or own OP." />
            <step n="6" text="FIND element's OPs: what it needs/wants from rest of AUE or outside to deliver own EF. Element functionality serves entities' OPs, so every OP found traces back through receivers to external VE's OP." />
            <step n="7" text="CONTINUE UNTIL no unsatisfied OPs remain, nor NEs of this AUE that must be named to understand artifact. Parametric Elements never NEs, not part of intake — tunable quality/quantity lacking own name in artifacts of this type is not named or enumerated, however many exist." />
            <step n="8" text="WHEN trace ends; RETURN to step 1 survey. No AUE functionality left out: FOR each functionality trace hasn't reached; FIND VE whose OP it serves; RECORD join. Where only part of already-named functionality, that parent join's function states it; NEXT functionality." />
            <step n="9" text="Whenever possible, CONSOLIDATE PE subfunctions into RE's parent function by mapping shared integration joins. ANNEAL and COMBINE elements where inferable functionality further refines structure by absorbing functional subparts logically sharing same join; never absorb subpart whose objective purpose parent functionality can't carry." />
            <step n="9b" text="Combining never optimizes functionality away. COMBINE only where bigger functionality describes both; LET purpose join carry combined encounter." />
            <step n="9c" text="Absorb subpart only when parent's purpose can carry subpart's purpose. For absorbed subpart, KEEP its purpose as refinement of parent's; RECORD it in own subtype join. Subpart with objective purpose parent can't carry stays own element." />
            <step n="10" text="WHEN combining elements; SEEK common element name placeable in namespace, obeying namespace naming rules, logically containing combined elements." />
            <step n="11" text="CONVERGE to final shape. Result = defining map of parent functionalities: element absorbed under steps 9-10 kept strictly as internal subtype of load-bearing parent functionality. Not mapped to external global graph; its atomic completeness, refined purpose, unique active-voice relation, specific encounter functions preserved in private internal subtype join." />
            <step n="12" text="PROOF recorded map; READ back whole; CHECK against artifact and this document; CORRECT; ANNEAL; COMPLETE; THEN FINISH intake." />
        </steps>
        <persistent_directive applies_from="step_5" text="Keep this document." />
        <output_instruction applies_from="step_11" text="Record final shape with intake tools; no document returned." />
    </method>
    <goal>
    Goal: refine high-value metaform capturing shape of artifact's function via element-by-element trace focused strictly on functionality. Traverse model's latent-space understanding of functionality, avoiding genre, medium, encoding, style, other functionality variants. Assemble element types seen as high value, address them per namespace rules, record each VE's OP (in join of type "purpose" describing active why and EF) of another element. No deeper intake on variants not describing functionality at leaf (genre, style, anything not distinctly observed functionality form). Recognize load-bearing nature of this statement and whole operation.
    </goal>
    <constraints>
        <constraint>Elements = discrete functional roles actively instantiated by this artifact, named and described at most specific reusable type level.</constraint>
        <constraint>Never vague top-level labels where specific functional mechanism exists.</constraint>
        <constraint>Namespace identity stays type-level; joins carry AUE-specific OP, EF, relation, observation, refs, non_goal where present.</constraint>
        <constraint>After process and closure pass, anneal joins and combine elements into final shape speaking to artifact type.</constraint>
        <constraint>Create thorough, complete map of parent functionalities.</constraint>
        <constraint>Graph shape limited to artifact's functional elements as type; joins speak to AUE function as whole.</constraint>
        <constraint>Focus on notable elements of interest; nameable ≠ interesting, remarkable, or worth special attention.</constraint>
        <constraint>Join speaks about this artifact. Purpose and function state what this AUE actually does, in its own particulars.</constraint>
        <constraint>Join data speaks to AUE. Where AUE represents something, describe function of that representation within AUE, not independent real-world functionality of thing represented.</constraint>
        <constraint>Every AUE: seek SE elements per core concepts.</constraint>
        <constraint>Intake never gated or judged; only resulting map may be graded, intake refined contextually after.</constraint>
    </constraints>
    <completion_condition>
    Done when final result = minimal base shape of notable categorical artifact elements, joined by artifact-specific OPs, fit for later expansion via project memory graph relations and other knowledge layers.
  </completion_condition>
    <response_protocol>
        <instructions>
            <instruction>result carries id. Unused internally here — exists so result can later be pasted into digital-typology-expand.xml's canonical_input, whose deep_result links back via matching ref. Generate it even though nothing in this file's output points to it; give as id when intake starts.</instruction>
            <instruction>Record result with intake tools, one object per call, as reasoned. Schema below defines each object's fields; not returned as document.</instruction>
            <instruction>When intake finished, recorded elements and joins express final annealed shape after Method step 12. Keep root element list minimal, coarse, shallow per Goal and Constraints by absorbing subparts. Don't leave absorbed subparts as independent root elements; remove them, preserve atomic realities only as subtype joins inside load-bearing parent's matching purpose join.</instruction>
            <instruction>Element identity = namespace_address attribute, not readable name. "tool registry" is prose; code.registry.tool is element. Any element reference, in join or elsewhere, must use namespace_address value, never name alone. Name with no matching namespace_address is not valid reference.</instruction>
            <instruction>All namespace records are elements. Element inside AUE carries exactly one role: DE, SE, or NE. VE outside AUE = element with role VE; gets no AUE role (DE/SE/NE). PE not a role attribute: it's join's other endpoint. Same element may bear OP as VE in one join and provide EF as PE in another, no duplication.</instruction>
            <instruction>Joins connect VE bearing OP to PE providing for it; carry purpose, function, ef, active-voice relation, verb, high-value observations (long-lasting stable state describing join), optional non-goals (structural constraints), refs where required. Applies to every join.</instruction>
            <instruction>Include refs on join only when it needs type-specific or artifact-specific references or logic beyond purpose, function, relation, observation, non_goal.</instruction>
            <instruction>non_goal optional; records structural constraint on join: something RE doesn't seek from PE, stated as boundary PE must not cross, where it materially clarifies OP. Omit when not applicable.</instruction>
        </instructions>
        <schema>
            <result id="[generated result id]" name="[a description of the AT and AUE present]">
                <refs>
                  <ref key="path" value="[project folder path]" />
                </refs>
                <elements>
                    <!-- All namespace records remain elements -->
                    <element namespace_address="[dotted namespace address]" name_length="[proper_noun_lookback_segment_count]" role="[AUE|VE|DE|SE|NE]">
                        <!-- Canonical Name (Project official terminology) or Informal Name -->
                        <name />
                        <joins>
                            <join type="purpose" provider="[namespace address of the Providing Element]" purpose="[State objective or standard this element or action fulfills.]" function="[Encounter Function of the PE within the RE context]" ef="[Function|Encounter]" relation="[Active-voice fragment starting with third-person singular present-tense verb ending -s/-es; implicit subject = PE if ef is Function, RE if ef is Encounter]" verb="[Single root verb from relation (e.g., provides, tracks, restricts)]" observation="[Only high-value, long-lasting, stable-state observations for agent orientation]" non_goal="[high-value non-goals: structural constraints]">
                                <refs>
                                    <!-- Uniform dictionary shape for type-specific or artifact-specific keys -->
                                    <ref key="[key]" value="[value]" />
                                </refs>
                                <!-- Internal subtype join: carries own specialized purpose and structural constraints -->
                                <join type="purpose" provider="[namespace address of the absorbed subtype]" purpose="[State objective or standard this element or action fulfills.]" function="[Encounter Function of the PE within the RE context]" ef="[Function|Encounter]" relation="[Active-voice fragment starting with third-person singular present-tense verb ending -s/-es; implicit subject = PE if ef is Function, RE if ef is Encounter]" verb="[Single root verb from relation (e.g., provides, tracks, restricts)]" observation="[Only high-value, long-lasting, stable-state observations for agent orientation]" non_goal="[high-value non-goals: structural constraints]">
                                    <element namespace_address="[dotted namespace address]" name_length="[proper_noun_lookback_segment_count]" role="[DE|SE|NE]">
                                        <name />
                                        <refs>
                                            <!-- Uniform dictionary shape for type-specific or artifact-specific keys -->
                                            <ref key="[key]" value="[value]" />
                                        </refs>
                                    </element>
                                </join>
                            </join>
                        </joins>
                    </element>
                </elements>
            </result>
        </schema>
    </response_protocol>
</process>
