<?xml version="1.0" encoding="utf-8"?>
<!-- The voice module's prompts: the text Metaform sends to agents for the voice module.
     Each element is one prompt, named by its tag. What is between the tags is sent exactly as written.
     An empty element inside a prompt, such as <name/>, would mark a place the code fills in; this file has none.
     Comments are never sent. -->
<prompts>
<!-- voice's line in the connect message: one short phrase saying what an agent uses the module for, written
     after the module's name, '– voice: <what it is for>', in the project's terms. Sent to every agent when it
     connects over MCP, one line per enabled module under mcp's <instructions>, and listed in the compact
     command-line guide, metaform help agents. Empty, as here, sends nothing. Off until the module is enabled, and
     when the folder's modules setting leaves it out. -->
<connect></connect>
<!-- voice's instructions. Returned by metaform_instructions with module voice, at metaform://instructions/voice, and printed by
     metaform help agents voice and by the full form of the command-line guide. Empty sends nothing.
     Off until the module is enabled. -->
<instructions>voice turns a person's speech into text on the web GUI. metaform voice status says which engine hears them and why; metaform voice transcribe file=&lt;path&gt; gives an audio file's text with the server engine.</instructions>
<!-- The line under the counts an agent is told at its node, MCP-039, when this module counts what it holds there with
     node_count: what is counted and the command that reads it, with <address> written as it is for the agent to fill,
     such as "Read them: metaform voice read node=<address>". Shown once per agent session, with the counts.
     Empty, as here, leaves the line out; a module with no node_count never shows it. -->
<counts></counts>
<!-- Module rules are delivered with the first use of its commands; each rule declares its why. -->
<rules></rules>
</prompts>
