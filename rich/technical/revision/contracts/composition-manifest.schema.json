{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metaform:schema:composition-manifest:1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "repository_id",
    "base_commit",
    "target_commit",
    "snapshot_key",
    "source_manifest_digest",
    "runtime_cut",
    "document_kind",
    "selection",
    "producer",
    "sections",
    "findings",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "metaform.composition/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_commit": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_key": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "runtime_cut": {
      "type": [
        "object",
        "null"
      ]
    },
    "document_kind": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object"
    },
    "producer": {
      "type": "object"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "path",
          "digest",
          "source_refs",
          "status"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "enum": [
              "generated",
              "reused",
              "failed"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state": {
      "enum": [
        "assembling",
        "complete",
        "failed"
      ]
    }
  }
}
